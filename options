# ============================================================================
# ddlcheck / PostgreSQL - Common Command-Line Options
# ============================================================================
#
# Usage:
#   java -cp 'out:src/main/resources:libs/*' dbradar.Main [global-options] postgresql [postgresql-options]
#
# Example:
#   java -cp 'out:src/main/resources:libs/*' dbradar.Main \
#     --username=postgres --password=Taurus_123 --host=127.0.0.1 --port=5432 \
#     --num-threads=2 --num-tries=2 --num-queries=100 \
#     --max-generated-databases=1 --database-prefix=ddlcheck_pg_ \
#     postgresql --oracle=equation
#

# ============================================================================
# [Global Options]
# ============================================================================

# Connection
--username=postgres                      # DB username
--password=Taurus_123                    # DB password
--host=127.0.0.1                         # DB host
--port=5432                              # PostgreSQL port

# Threading & Execution
--num-threads=16                         # Concurrent threads testing separate databases
--num-tries=100                          # Database tasks to create in total
--num-queries=100000                     # Queries per database before recreating
--timeout-seconds=-1                     # Global timeout in seconds, -1=unlimited
--max-generated-databases=-1             # Max databases per thread, -1=unlimited
--random-seed=-1                         # Random seed, -1=use system time

# Logging
--log-each-select=true                   # Log every statement issued
--log-execution-time=true                # Log execution time per statement
--print-failed=false                     # Log failed statements
--print-progress-information=true        # Print throughput progress every 5s
--print-progress-summary=false           # Print summary on exit
--print-statements=false                 # Print all statements to stdout
--print-succeeding-statements=false      # Print successful statements to stdout

# SQL Generation
--max-num-inserts=30                     # How many INSERT statements to issue
--max-expression-depth=3                 # Max depth of randomly-generated expressions
--num-statement-kind-retries=1000        # Retries for a specific statement kind
--random-string-generation=SOPHISTICATED # String generation strategy
--string-constant-max-length=10          # Max length of generated string constants
--use-constant-caching=true              # Cache and reuse constants
--constant-cache-size=100                # Size of the constant cache
--max-production-recursion=3             # Max grammar production recursion depth

# Grammar
--grammar-path=                          # Custom grammar path
--generator-config-path=                 # Custom Lua generator config path

# Database
--database-prefix=database               # Prefix for created database names
--use-connection-test=true               # Test connection before multi-thread run
--canonicalize-sql-strings=true          # Add ';' to query strings
--validate-result-size-only=false        # Only validate result size, skip content
--test-only-nonempty-tables=false        # Only test tables with at least one row

# Exit
--exit-code-error=-1                     # Exit code on error or bug found
--help                                   # Print help

# Experimental - QPG
--qpg-enable=false                       # Enable Query Plan Guidance
--qpg-log-query-plan=false               # Log query plans
--qpg-max-interval=1000                  # Max iterations to mutate if no new plans
--qpg-reward-weight=0.25                 # Weight of last reward in average
--qpg-selection-probability=0.7          # Probability of random mutator selection

# Transaction
--use-fixed-num-transaction=false        # Use fixed number of transactions
--num-transaction=2                      # Number of transactions per database
--num-schedule=10                        # Schedules per transaction group
--case-file=                             # Input file for specified case
--execute-time-minutes=10                # Time to generate and execute transactions
--pqs-test-aggregates=false              # Test aggregate functions with single-row tables

# ============================================================================
# [PostgreSQL-Specific Options] - placed after "postgresql" subcommand
# ============================================================================

--oracle=equation                        # PostgreSQL equation oracle
--bulk-insert=false                      # Issue INSERT statements in bulk
--test-collations=true                   # Test different collations
--connection-url=postgresql://localhost:5432/test
--extensions=                            # Comma-separated extensions to create per test database
